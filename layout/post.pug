---
layout: layout
---
article.post-detail
  header.post-detail__header
    h1.post-detail__title= page.title

    .post-detail__meta
      if page.date
        time.post-detail__meta-item(datetime=page.date.toISOString())
          svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
            rect(x="3" y="4" width="18" height="18" rx="2")
            line(x1="16" y1="2" x2="16" y2="6")
            line(x1="8" y1="2" x2="8" y2="6")
            line(x1="3" y1="10" x2="21" y2="10")
          span= date(page.date, 'YYYY-MM-DD')

      if page.categories.length
        a.post-detail__meta-item.post-detail__category(href=url_for(page.categories.first().path))
          svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
            path(d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z")
          span= page.categories.first().name

      if theme.post.word_count && page.wordcount
        span.post-detail__meta-item
          svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
            path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
            polyline(points="14 2 14 8 20 8")
          span= __('post.word_count', page.wordcount)

      if theme.post.reading_time && page.reading_time
        span.post-detail__meta-item
          svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
            circle(cx="12" cy="12" r="10")
            polyline(points="12 6 12 12 16 14")
          span= __('post.reading_time', page.reading_time)

    if page.tags.length
      .post-detail__tags
        each tag in page.tags.toArray()
          a.post-detail__tag(href=url_for(tag.path))= '#' + tag.name

  if page.cover
    img.post-detail__cover(src=url_for(page.cover) alt=page.title)

  .post-detail__content
    != page.content
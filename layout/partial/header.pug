header.header
  .header__inner
    .header__brand
      if theme.header && theme.header.logo
        img.header__logo(
          src=url_for(theme.header.logo)
          alt=theme.header.title || config.title
          data-header-logo
        )
        if theme.header.logo_dark
          img.header__logo.header__logo--dark(
            src=url_for(theme.header.logo_dark)
            alt=theme.header.title || config.title
            data-header-logo-dark
          )
      a.header__title(href=url_for('/'))
        if theme.header && theme.header.title
          = theme.header.title
        else
          = config.title

    nav.header__nav
      if theme.menu
        each item, label in theme.menu
          -
            var navPath = typeof item === 'string' ? item : item.path
            var navIcon = typeof item === 'string' ? null : item.icon
            var isActive = navPath === '/'
              ? (page.path === '' || page.path === 'index.html')
              : page.path.startsWith(navPath.replace('/', ''))
          if navPath && label
            a.header__nav-link(
              class={'header__nav-link--active': isActive}
              href=url_for(navPath)
            )
              if navIcon
                i.fas(class=`fa-${navIcon}`)
              span.header__nav-label= label

    .header__actions
      -
        var wallpaperData = []
        if (theme.wallpaper && theme.wallpaper.enable && theme.wallpaper.list) {
          theme.wallpaper.list.forEach(function(wp) {
            if (wp.name) wallpaperData.push({ name: wp.name, url: wp.url ? url_for(wp.url) : '', thumb: wp.thumb ? url_for(wp.thumb) : '' })
          })
        }
        var defaultWallpaperName = (theme.wallpaper && theme.wallpaper.default_wallpaper) ? theme.wallpaper.default_wallpaper : ''
        var defaultWallpaperIdx = 0
        if (defaultWallpaperName && wallpaperData.length > 0) {
          for (var di = 0; di < wallpaperData.length; di++) {
            if (wallpaperData[di].name === defaultWallpaperName) {
              defaultWallpaperIdx = di
              break
            }
          }
        }
        var wallpapersPerPage = 12
        var totalWallpaperPages = Math.ceil(wallpaperData.length / wallpapersPerPage)

      .settings-dropdown(data-settings data-wallpapers=JSON.stringify(wallpaperData) data-default-wallpaper-index=defaultWallpaperIdx)
        button.btn.btn--icon(
          data-settings-toggle
          aria-label=__('settings.label')
          aria-expanded="false"
        )
          i.fas.fa-gear

        nav.settings-dropdown__panel(data-settings-panel role="menu")
          .settings-dropdown__group
            span.settings-dropdown__label= __('settings.theme')
            .settings-dropdown__row
              each flavor, i in ['latte', 'frappe', 'macchiato', 'mocha']
                button.settings-dropdown__theme-btn(
                  data-theme-value=flavor
                  role="menuitemradio"
                  aria-checked=(i === 0 ? 'true' : 'false')
                )
                  span.settings-dropdown__theme-dot(class=`settings-dropdown__theme-dot--${flavor}`)
                  span= flavor.charAt(0).toUpperCase() + flavor.slice(1)

          .settings-dropdown__group
            span.settings-dropdown__label= __('settings.accent')
            .settings-dropdown__row.settings-dropdown__row--accents
              each color in ['rosewater', 'flamingo', 'pink', 'mauve', 'red', 'maroon', 'peach', 'yellow', 'green', 'teal', 'sky', 'sapphire', 'blue', 'lavender']
                button.settings-dropdown__accent-btn(
                  data-accent-value=color
                  role="menuitemradio"
                  aria-checked=(color === 'mauve' ? 'true' : 'false')
                  aria-label=color
                )
                  span.settings-dropdown__accent-dot(style=`background: var(--ctp-${color})`)

          if wallpaperData.length > 0
            .settings-dropdown__group(data-wallpaper-group)
              span.settings-dropdown__label= __('settings.wallpaper')
              .settings-dropdown__row.settings-dropdown__row--wallpapers(data-wallpaper-grid)
                each wp, idx in wallpaperData
                  button.settings-dropdown__wallpaper-btn(
                    data-wallpaper-index=idx
                    data-wallpaper-page=Math.floor(idx / wallpapersPerPage)
                    role="menuitemradio"
                    aria-checked=(idx === defaultWallpaperIdx ? 'true' : 'false')
                    aria-label=wp.name
                  )
                    if wp.thumb
                      img.settings-dropdown__wallpaper-thumb(src=wp.thumb alt='' loading="lazy")
              if totalWallpaperPages > 1
                .settings-dropdown__wallpaper-pagination(data-wallpaper-pagination)
                  button.settings-dropdown__wallpaper-page-btn(
                    data-wallpaper-prev
                    disabled
                    aria-label=__('pagination.prev')
                  )
                    i.fas.fa-chevron-left
                  span.settings-dropdown__wallpaper-page-info(data-wallpaper-page-info)= '1 / ' + totalWallpaperPages
                  button.settings-dropdown__wallpaper-page-btn(
                    data-wallpaper-next
                    aria-label=__('pagination.next')
                  )
                    i.fas.fa-chevron-right

      button.btn.btn--icon(data-mobile-nav-toggle aria-label=__('menu.toggle') aria-expanded="false")
        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
          line(x1="3" y1="6" x2="21" y2="6")
          line(x1="3" y1="12" x2="21" y2="12")
          line(x1="3" y1="18" x2="21" y2="18")
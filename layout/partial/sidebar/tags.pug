if site.tags.length
  -
    var tagAccents = ['rosewater','flamingo','pink','mauve','red','maroon','peach','yellow','green','teal','sky','sapphire','blue','lavender']
  .card.card--flat.p-lg
    h3.sidebar__section-title
      i.fas.fa-tags.mr-sm
      span= __('page.tags')
    .sidebar__taxonomy-list
      each tag in site.tags.toArray()
        a.sidebar__taxonomy-item(class='tax-c-' + Math.floor(Math.random() * 14) href=url_for(tag.path))
          span= tag.name
          span.sidebar__taxonomy-count= tag.length
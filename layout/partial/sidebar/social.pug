if theme.profile.social
  .card.card--flat.p-lg
    nav.sidebar__social
      each url, platform in theme.profile.social
        if url
          -
            var meta   = socialMeta[platform] || { icon: 'fas fa-link', external: true }
            var label  = platform.charAt(0).toUpperCase() + platform.slice(1)
            var isMail = /^mailto:/i.test(url)
            var attrs  = meta.external && !isMail
              ? { target: '_blank', rel: 'noopener' }
              : {}
          a.sidebar__social-link(href=url aria-label=label)&attributes(attrs)
            i(class=meta.icon)
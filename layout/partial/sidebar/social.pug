    discord:    { icon: 'fab fa-discord',      external: true  },
    youtube:    { icon: 'fab fa-youtube',      external: true  },
    instagram:  { icon: 'fab fa-instagram',    external: true  },
    linkedin:   { icon: 'fab fa-linkedin',     external: true  },
    facebook:   { icon: 'fab fa-facebook',     external: true  },
    reddit:     { icon: 'fab fa-reddit',       external: true  },
    tiktok:     { icon: 'fab fa-tiktok',       external: true  },
    medium:     { icon: 'fab fa-medium',       external: true  },
    mastodon:   { icon: 'fab fa-mastodon',     external: true  },
    twitch:     { icon: 'fab fa-twitch',       external: true  },
    steam:      { icon: 'fab fa-steam',        external: true  },

    'ko-fi':    { icon: 'fas fa-mug-hot',      external: true  },
    kofi:       { icon: 'fas fa-mug-hot',      external: true  },
    dribbble:   { icon: 'fab fa-dribbble',     external: true  },
    behance:    { icon: 'fab fa-behance',      external: true  },
    codepen:    { icon: 'fab fa-codepen',      external: true  },
